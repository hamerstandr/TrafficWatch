    <sys:String x:Key="Interface">واجهة الشبكة</sys:String>
    <sys:String x:Key="InterfaceType">نوع الواجهة</sys:String>
    <sys:String x:Key="IPAddress">عنوان IP</sys:String>
    <sys:String x:Key="Download">تنزيل</sys:String>
    <sys:String x:Key="Upload">رفع</sys:String>
    <sys:String x:Key="Speed">السرعة</sys:String>
