    <sys:String x:Key="WebDashboard">لوحة تحكم الويب</sys:String>
    <sys:String x:Key="OpenInBrowser">فتح في المتصفح</sys:String>
    <sys:String x:Key="RealTimeMonitoring">المراقبة في الوقت الحقيقي</sys:String>
    
    <!-- Messages -->
    <sys:String x:Key="WinPcapNotFound">لم يتم العثور على WinPcap. يرجى تثبيته.</sys:String>
    <sys:String x:Key="RestartRequired">إعادة التشغيل مطلوبة لتطبيق التغييرات.</sys:String>
