<UserControl x:Class="TrafficWatch.View.Dashboard.DownloadManagerTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:TrafficWatch.View.Dashboard"
        mc:Ignorable="d" 
        d:DesignHeight="400" d:DesignWidth="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- هدر: اطلاعات کلی -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Active Downloads:" FontWeight="Bold" Foreground="{DynamicResource WindowForeground}"/>
                    <TextBlock x:Name="TxtActiveDownloads" Text="0" FontSize="18" Foreground="{DynamicResource WindowForeground}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Download Speed:" FontWeight="Bold" Foreground="{DynamicResource WindowForeground}"/>
                    <TextBlock x:Name="TxtDownloadSpeed" Text="0 KB/s" FontSize="18" Foreground="{DynamicResource WindowForeground}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Status:" FontWeight="Bold" Foreground="{DynamicResource WindowForeground}"/>
                    <TextBlock x:Name="TxtStatus" Text="Disconnected" FontSize="18" Foreground="Red"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- لیست دانلودهای فعال -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DownloadsList">
                    <TextBlock Text="No active downloads" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Foreground="Gray"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
